# Copy to /etc/halt-watcher.env (chmod 600) or `source` it in your shell.
# The topic name IS the password — anyone who knows it can read your alerts.
# Make it long and random, e.g.:  openssl rand -hex 8

NTFY_TOPIC=cullen-halts-CHANGE-ME-3f9a2c1b
NTFY_SERVER=https://ntfy.sh
POLL_SECONDS=8

# Reason codes to alert on. Default (if unset) is LULD + market-wide.
# Set to "all" for every halt code in the feed.
HALT_REASONS=LUDP,LUDS,MWC0,MWC1,MWC2,MWC3,MWCQ,M,M1,M2

# Optional: only alert on these symbols. Leave empty for every symbol.
HALT_SYMBOLS=

# Optional: only if you use a protected topic on your own ntfy server.
# NTFY_TOKEN=tk_...

HALT_STATE=/opt/halt-watcher/state.json
